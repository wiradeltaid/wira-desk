/target/
/out/

# Packaging scratch. `stage/` is what the installer is built from, `dist/` is what it is
# built into, and `nsis/` is the checksum-verified toolchain the workflow unpacks. All
# three are produced by `ci.yml` and `release.yml`; none is a source artefact.
/stage/
/dist/
/nsis/
/nsis.zip
__pycache__/
*.pyc

# Local-only editor overrides — not part of the committed agent configuration.
/.cursorrules.local

# The planning archive under `_bmad-output/` is committed source.
# `_bmad/`, `.claude/`, `.agents/`, and `.work/` are committed too — see CONTRIBUTING.md.
# Local runner configuration (never commit personal runners/credentials)
.control/custom-dispatch.yaml

# Ephemeral smoke test artifacts
.work/smoke/

# Derived human-readable document projections (regenerated via validate.py --generate or /wdi-report render)
/.what-rendered/
/.how-rendered/

# Ephemeral execution scratch and raw tool dumps
.work/*.txt
.work/*.log
.work/tmp/
