import { Palette, Typography } from "../theme.slint";
import { Card, CardDivider } from "../components/card.slint";
import { ShortcutRow } from "../components/shortcut_row.slint";

// One editable action, as the pane needs it.
//
// The pane is driven entirely by these rows rather than by one property per field. Nine
// actions times four properties was thirty-six hand-written bindings, which is the shape
// that lets an action be added to the model and silently never drawn. `index` is the
// action's position in the declared sequence (`LBR-ST-14`) and is what the capture and swap
// callbacks carry back; it is deliberately not the row's position inside its group.
export struct ShortcutRowData {
    index: int,
    title: string,
    description: string,
    shortcut: string,
    conflict_name: string,
    can_swap: bool,
    has_percent: bool,
    percent: int,
    percent_min: int,
    percent_max: int,
    accessible_label_decrease: string,
    accessible_label_field: string,
    accessible_label_input: string,
    accessible_label_increase: string,
    accessible_label_keycap: string,
    accessible_label_description: string,
    enabled: bool,
}

// A labelled group of rows: one card, one heading.
component ShortcutGroup inherits VerticalLayout {
    in property <string> heading;
    in property <[ShortcutRowData]> rows;
    in property <int> listening_field: -1;
    in property <int> revert_generation: 0;

    callback capture(int);
    callback swap(int);
    callback percent_changed(int, int);
    callback editing_changed(int, int);
    callback toggle_enabled(int, bool);
    callback show_tooltip(string, length);
    callback hide_tooltip();

    spacing: 6px;

    Text {
        text: root.heading;
        accessible-role: text;
        accessible-label: root.heading;
        font-family: Typography.font_family;
        font-size: Typography.size_caption;
        font-weight: 600;
        letter-spacing: 0.8px;
        color: Palette.text_secondary;
    }

    card := Card {
        VerticalLayout {
            padding: 0px;
            for row[i] in root.rows: VerticalLayout {
                if i > 0: CardDivider {}
                ShortcutRow {
                    title: row.title;
                    description: row.description;
                    current_shortcut: row.shortcut;
                    is_listening: root.listening_field == row.index;
                    conflict_name: row.conflict_name;
                    can_swap: row.can_swap;
                    has_percent: row.has_percent;
                    percent: row.percent;
                    percent_min: row.percent_min;
                    percent_max: row.percent_max;
                    accessible_label_decrease: row.accessible_label_decrease;
                    accessible_label_field: row.accessible_label_field;
                    accessible_label_input: row.accessible_label_input;
                    accessible_label_increase: row.accessible_label_increase;
                    accessible_label_keycap: row.accessible_label_keycap;
                    accessible_label_description: row.accessible_label_description;
                    enabled: row.enabled;
                    revert_generation: root.revert_generation;
                    capture_clicked => {
                        root.capture(row.index);
                    }
                    swap_clicked => {
                        root.swap(row.index);
                    }
                    percent_changed(val) => {
                        root.percent_changed(row.index, val);
                    }
                    editing_changed(val) => {
                        root.editing_changed(row.index, val);
                    }
                    toggle_enabled(val) => {
                        root.toggle_enabled(row.index, val);
                    }
                    show_tooltip(desc, row_y) => {
                        root.show_tooltip(desc, card.y + (i * 54px) + 55px);
                    }
                    hide_tooltip => {
                        root.hide_tooltip();
                    }
                }
            }
        }
    }
}

export component ShortcutsPane inherits VerticalLayout {
    // Five groups, taxonomy per `DEC-014` (`LBR-ST-14`), driven from `ShortcutField::ALL`.
    in property <[ShortcutRowData]> rows_switching;
    in property <[ShortcutRowData]> rows_snap_half;
    in property <[ShortcutRowData]> rows_snap_third;
    in property <[ShortcutRowData]> rows_snap_custom;
    in property <[ShortcutRowData]> rows_arrange;
    in property <int> revert_generation: 0;

    in property <int> listening_field: -1; // -1 = idle, otherwise the action's index
    in property <bool> show_defaults_button: false;
    in property <bool> show_stack_conflict_banner: false;
    in property <bool> can_fix_stack_conflict: false;

    // The Key check diagnostic is deliberately NOT here. It is a live instrument — you press
    // a chord and read what it observed — so it has to stay visible while you are editing the
    // rows. Nine rows scroll it off the screen at exactly the moment it is useful, so the
    // shell pins it in a band of its own above the save footer. See `main_window.slint`.

    callback start_capture(int);
    callback swap_shortcuts(int);
    callback percent_changed(int, int);
    callback editing_percent_changed(int, int);
    callback toggle_enabled(int, bool);
    callback show_tooltip(string, length);
    callback hide_tooltip();
    callback restore_shortcuts_clicked();
    callback fix_stack_conflict_clicked();

    spacing: 14px;
    alignment: start;

    // Heading Section
    HorizontalLayout {
        alignment: space-between;

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: "Shortcuts Configuration";
                font-family: Typography.font_family;
                font-size: Typography.size_heading;
                font-weight: 700;
                color: Palette.text_primary;
            }

            Text {
                text: "Click any shortcut button to record physical key combinations directly. Every action Wira Desk can trigger lives here.";
                font-family: Typography.font_family;
                font-size: Typography.size_caption;
                color: Palette.text_secondary;
                wrap: word-wrap;
            }
        }

        // Secondary Restore Shortcuts Action Button (SPEC-25-01, SPEC-26-01)
        if root.show_defaults_button : HorizontalLayout {
            alignment: end;
            padding-left: 12px;

            Rectangle {
                width: 96px;
                height: 32px;
                border-radius: 6px;
                background: restore_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;
                border-width: 1px;
                border-color: Palette.stroke_card;

                Text {
                    text: "↺ Defaults";
                    font-family: Typography.font_family;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Palette.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                restore_touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "Restore shortcuts to defaults";
                    accessible-action-default => {
                        root.restore_shortcuts_clicked();
                    }
                    mouse-cursor: pointer;
                    clicked => {
                        root.restore_shortcuts_clicked();
                    }
                }
            }
        }
    }

    // Legacy Conflict Banner (SPEC-25-01)
    if root.show_stack_conflict_banner : Card {
        background: Palette.is_dark ? rgba(255, 185, 0, 0.12) : rgba(255, 185, 0, 0.15);
        border-color: Palette.signal_warning;

        VerticalLayout {
            padding: 14px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: "⚠";
                    font-size: 14px;
                    vertical-alignment: center;
                }

                Text {
                    text: "Update a conflicting shortcut";
                    font-family: Typography.font_family;
                    font-size: Typography.size_body;
                    font-weight: 700;
                    color: Palette.text_primary;
                    accessible-role: text;
                    accessible-label: "Update a conflicting shortcut";
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.can_fix_stack_conflict
                    ? "“Overlapping window stack” used the same shortcut as “Snap to bottom edge.” Move it to its new default shortcut: Ctrl + Alt + Shift + S."
                    : "“Overlapping window stack” used the same shortcut as “Snap to bottom edge.” However, the new default shortcut (Ctrl + Alt + Shift + S) is already in use by another enabled action. Please manually choose a unique shortcut.";
                font-family: Typography.font_family;
                font-size: Typography.size_caption;
                color: Palette.text_secondary;
                wrap: word-wrap;
            }

            if root.can_fix_stack_conflict : HorizontalLayout {
                alignment: start;
                padding-top: 4px;

                Rectangle {
                    width: 140px;
                    height: 30px;
                    border-radius: 6px;
                    background: update_touch.has_hover ? Palette.accent_hover : Palette.accent_primary;

                    Text {
                        text: "Update shortcut";
                        accessible-role: none;
                        font-family: Typography.font_family;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: Palette.text_on_accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    update_touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Update shortcut";
                        accessible-action-default => {
                            root.fix_stack_conflict_clicked();
                        }
                        mouse-cursor: pointer;
                        clicked => {
                            root.fix_stack_conflict_clicked();
                        }
                    }
                }
            }
        }
    }

    ShortcutGroup {
        heading: "Switching";
        rows: root.rows_switching;
        listening_field: root.listening_field;
        revert_generation: root.revert_generation;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
        percent_changed(i, val) => {
            root.percent_changed(i, val);
        }
        editing_changed(i, val) => {
            root.editing_percent_changed(i, val);
        }
        toggle_enabled(i, val) => {
            root.toggle_enabled(i, val);
        }
        show_tooltip(desc, group_y) => {
            root.show_tooltip(desc, self.y + group_y);
        }
        hide_tooltip => {
            root.hide_tooltip();
        }
    }

    ShortcutGroup {
        heading: "Snap to half";
        rows: root.rows_snap_half;
        listening_field: root.listening_field;
        revert_generation: root.revert_generation;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
        percent_changed(i, val) => {
            root.percent_changed(i, val);
        }
        editing_changed(i, val) => {
            root.editing_percent_changed(i, val);
        }
        toggle_enabled(i, val) => {
            root.toggle_enabled(i, val);
        }
        show_tooltip(desc, group_y) => {
            root.show_tooltip(desc, self.y + group_y);
        }
        hide_tooltip => {
            root.hide_tooltip();
        }
    }

    ShortcutGroup {
        heading: "Snap to third";
        rows: root.rows_snap_third;
        listening_field: root.listening_field;
        revert_generation: root.revert_generation;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
        percent_changed(i, val) => {
            root.percent_changed(i, val);
        }
        editing_changed(i, val) => {
            root.editing_percent_changed(i, val);
        }
        toggle_enabled(i, val) => {
            root.toggle_enabled(i, val);
        }
        show_tooltip(desc, group_y) => {
            root.show_tooltip(desc, self.y + group_y);
        }
        hide_tooltip => {
            root.hide_tooltip();
        }
    }

    ShortcutGroup {
        heading: "Snap to custom";
        rows: root.rows_snap_custom;
        listening_field: root.listening_field;
        revert_generation: root.revert_generation;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
        percent_changed(i, val) => {
            root.percent_changed(i, val);
        }
        editing_changed(i, val) => {
            root.editing_percent_changed(i, val);
        }
        toggle_enabled(i, val) => {
            root.toggle_enabled(i, val);
        }
        show_tooltip(desc, group_y) => {
            root.show_tooltip(desc, self.y + group_y);
        }
        hide_tooltip => {
            root.hide_tooltip();
        }
    }

    ShortcutGroup {
        heading: "Resize, move & arrange";
        rows: root.rows_arrange;
        listening_field: root.listening_field;
        revert_generation: root.revert_generation;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
        percent_changed(i, val) => {
            root.percent_changed(i, val);
        }
        editing_changed(i, val) => {
            root.editing_percent_changed(i, val);
        }
        toggle_enabled(i, val) => {
            root.toggle_enabled(i, val);
        }
        show_tooltip(desc, group_y) => {
            root.show_tooltip(desc, self.y + group_y);
        }
        hide_tooltip => {
            root.hide_tooltip();
        }
    }
}
