import { Palette, Typography } from "../theme.slint";
import { Card, CardDivider } from "../components/card.slint";
import { SettingToggleRow } from "../components/setting_toggle_row.slint";

component OpenLinkIcon inherits Rectangle {
    in property <color> icon_color: Palette.text_primary;
    width: 12px;
    height: 12px;

    Path {
        width: 12px;
        height: 12px;
        x: 0px;
        y: 0px;
        stroke: root.icon_color;
        stroke-width: 1.2px;
        MoveTo { x: 5; y: 3; } LineTo { x: 2; y: 3; }
        LineTo { x: 2; y: 10; } LineTo { x: 9; y: 10; } LineTo { x: 9; y: 7; }
        MoveTo { x: 6; y: 2; } LineTo { x: 10; y: 2; } LineTo { x: 10; y: 6; }
        MoveTo { x: 10; y: 2; } LineTo { x: 5; y: 7; }
    }
}

export component AboutPane inherits VerticalLayout {
    in property <string> version: "0.1.0";
    in property <string> typeface: "Segoe UI Variable Text (System Loaded)";

    // Updates. `status` is the one line the user reads, written by the Rust side for every
    // outcome, because "update failed" tells nobody anything -- see `update::describe`.
    in property <string> update_status: "";
    in property <bool> update_busy: false;
    in property <bool> update_ready: false;
    in property <string> update_version: "";
    in property <bool> update_has_notes: false;
    callback open_release_notes();
    in-out property <bool> check_updates: true;

    callback check_updates_clicked();
    callback install_update_clicked();
    callback check_updates_toggled(bool);
    callback open_publisher_url();
    callback open_source_url();
    callback open_support_url();
    callback open_issues_url();
    callback open_privacy_url();
    callback reset_all_settings_clicked();

    spacing: 12px;
    alignment: start;

    // Heading Section
    VerticalLayout {
        spacing: 4px;
        Text {
            text: "Wira Desk " + root.version;
            font-family: Typography.font_family;
            font-size: Typography.size_heading;
            font-weight: 700;
            color: Palette.text_primary;
        }

        Text {
            text: "Copyright (c) 2026 Wira Delta Indonesia";
            font-family: Typography.font_family;
            font-size: Typography.size_caption;
            color: Palette.text_secondary;
        }
    }

    // Card 1: Description, License, Source, Privacy (Section C Fixture)
    Card {
        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            Text {
                text: "Same-app window cycling, one-key snapping, and mouse button mapping for Windows\u{00A0}11.";
                font-family: Typography.font_family;
                font-size: Typography.size_body;
                color: Palette.text_secondary;
                wrap: word-wrap;
            }

            Text {
                text: "Free software under the GNU General Public License v3.0 only.\nFull terms: LICENSE.txt in the install folder.\nThird-party components and their licenses: NOTICE.txt in the install folder.";
                font-family: Typography.font_family;
                font-size: Typography.size_caption;
                color: Palette.text_tertiary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                source_touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "Source: github.com/wiradeltaid/wira-desk";
                    accessible-action-default => { root.open_source_url(); }
                    mouse-cursor: pointer;
                    clicked => { root.open_source_url(); }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        Text {
                            text: "Source: github.com/wiradeltaid/wira-desk";
                            font-family: Typography.font_family;
                            font-size: Typography.size_caption;
                            color: source_touch.has_hover ? Palette.accent_hover : Palette.accent_primary;
                        }
                        VerticalLayout {
                            alignment: center;
                            OpenLinkIcon {
                                icon_color: source_touch.has_hover ? Palette.accent_hover : Palette.accent_primary;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                privacy_touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "What it stores and sends: wiradelta.id/wira-desk/privacy/";
                    accessible-action-default => { root.open_privacy_url(); }
                    mouse-cursor: pointer;
                    clicked => { root.open_privacy_url(); }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        Text {
                            text: "What it stores and sends: wiradelta.id/wira-desk/privacy/";
                            font-family: Typography.font_family;
                            font-size: Typography.size_caption;
                            color: privacy_touch.has_hover ? Palette.accent_hover : Palette.accent_primary;
                        }
                        VerticalLayout {
                            alignment: center;
                            OpenLinkIcon {
                                icon_color: privacy_touch.has_hover ? Palette.accent_hover : Palette.accent_primary;
                            }
                        }
                    }
                }
            }
        }
    }

    // Card 2: Update Check and Privacy Disclosure (Section C Fixture)
    Card {
        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            SettingToggleRow {
                title: "Check for updates automatically";
                description: "Once a day, and when you press Check for updates, Wira Desk asks wiradelta.id whether a newer version exists. The request names Wira Desk, its version, your Windows version, and the processor architecture. Nothing else is attached.\nNo account, no analytics, no crash reporting.";
                checked <=> root.check_updates;
                toggled(val) => { root.check_updates_toggled(val); }
            }

            CardDivider {}

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 16px;
                spacing: 10px;
                alignment: start;

                // Two buttons, never both. "Check" until something is found, then "Install".
                if !root.update_ready : Rectangle {
                    width: 132px;
                    height: 32px;
                    border-radius: 6px;
                    background: root.update_busy
                        ? Palette.bg_subtle
                        : (check_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle);
                    border-width: 1px;
                    border-color: Palette.stroke_card;

                    Text {
                        text: root.update_busy ? "Checking…" : "Check for updates";
                        font-family: Typography.font_family;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: root.update_busy ? Palette.text_tertiary : Palette.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    check_touch := TouchArea {
                        enabled: !root.update_busy;
                        clicked => { root.check_updates_clicked(); }
                    }
                }

                if root.update_ready && root.update_has_notes : Rectangle {
                    width: 96px;
                    height: 32px;
                    border-radius: 6px;
                    background: notes_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;
                    border-width: 1px;
                    border-color: Palette.stroke_card;

                    Text {
                        text: "What is new";
                        font-family: Typography.font_family;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: Palette.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    notes_touch := TouchArea {
                        clicked => { root.open_release_notes(); }
                    }
                }

                if root.update_ready : Rectangle {
                    width: 150px;
                    height: 32px;
                    border-radius: 6px;
                    background: root.update_busy
                        ? Palette.text_tertiary
                        : (install_touch.has_hover ? Palette.accent_hover : Palette.accent_primary);

                    Text {
                        text: root.update_busy ? "Downloading…" : "Download and install";
                        font-family: Typography.font_family;
                        font-size: 12.5px;
                        font-weight: 700;
                        color: Palette.text_on_accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    install_touch := TouchArea {
                        enabled: !root.update_busy;
                        clicked => { root.install_update_clicked(); }
                    }
                }
            }

            if root.update_ready : HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 8px;
                Text {
                    text: "Wira Desk will close, Windows will ask for your permission, and version "
                        + root.update_version + " will install. Your settings are kept.";
                    font-family: Typography.font_family;
                    font-size: Typography.size_caption;
                    color: Palette.text_secondary;
                    wrap: word-wrap;
                }
            }

            if root.update_status != "" : HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 8px;
                Text {
                    text: root.update_status;
                    font-family: Typography.font_family;
                    font-size: Typography.size_caption;
                    color: Palette.text_secondary;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Card 3: Support, Contacts, Actions & Recovery Section
    Card {
        accessible-role: text;
        accessible-label: "Support and recovery card";

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 8px;
                spacing: 4px;

                Text {
                    text: "Questions: support@wiradelta.id";
                    font-family: Typography.font_family;
                    font-size: Typography.size_caption;
                    color: Palette.text_secondary;
                }

                Text {
                    text: "Security reports: GitHub Security Advisories on the repository";
                    font-family: Typography.font_family;
                    font-size: Typography.size_caption;
                    color: Palette.text_secondary;
                }
            }

            // Action Row: Send a tip, Issue Tracker
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 4px;
                padding-bottom: 14px;
                spacing: 10px;
                alignment: start;

                Rectangle {
                    width: 104px;
                    height: 32px;
                    border-radius: 6px;
                    background: support_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;
                    border-width: 1px;
                    border-color: Palette.stroke_card;

                    Text {
                        text: "Send a tip";
                        font-family: Typography.font_family;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: Palette.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    support_touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Send a tip";
                        accessible-action-default => { root.open_support_url(); }
                        mouse-cursor: pointer;
                        clicked => { root.open_support_url(); }
                    }
                }

                Rectangle {
                    width: 114px;
                    height: 32px;
                    border-radius: 6px;
                    background: issues_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;
                    border-width: 1px;
                    border-color: Palette.stroke_card;

                    Text {
                        text: "Issue Tracker";
                        font-family: Typography.font_family;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: Palette.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    issues_touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Issue Tracker";
                        accessible-action-default => { root.open_issues_url(); }
                        mouse-cursor: pointer;
                        clicked => { root.open_issues_url(); }
                    }
                }
            }

            CardDivider {}

            // Recovery Section
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 8px;

                Text {
                    text: "Restore all preferences to defaults";
                    font-family: Typography.font_family;
                    font-size: Typography.size_body;
                    font-weight: 700;
                    color: Palette.text_primary;
                    accessible-role: text;
                    accessible-label: "Restore all preferences to defaults";
                }

                Text {
                    text: "Stages clean-install factory defaults for every section. No configuration file on disk, scheduled task, or running daemon will change until you choose Save Changes.";
                    font-family: Typography.font_family;
                    font-size: Typography.size_caption;
                    color: Palette.text_secondary;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: start;

                    Rectangle {
                        width: 156px;
                        height: 32px;
                        border-radius: 6px;
                        background: reset_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;
                        border-width: 1px;
                        border-color: Palette.stroke_card;

                        Text {
                            text: "Reset all settings…";
                            font-family: Typography.font_family;
                            font-size: 12.5px;
                            font-weight: 600;
                            color: Palette.signal_error;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        reset_touch := TouchArea {
                            accessible-role: button;
                            accessible-label: "Reset all settings to defaults";
                            accessible-action-default => { root.reset_all_settings_clicked(); }
                            mouse-cursor: pointer;
                            clicked => { root.reset_all_settings_clicked(); }
                        }
                    }
                }
            }
        }
    }
}
