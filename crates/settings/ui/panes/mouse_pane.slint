import { Palette, Typography } from "../theme.slint";
import { Card, CardDivider } from "../components/card.slint";
import { SettingToggleRow } from "../components/setting_toggle_row.slint";

export struct MousePresetOption {
    slug: string,
    label: string,
}

component MouseActionRow inherits Rectangle {
    in property <string> title: "";
    in property <string> description: "";
    in property <string> action_label: "";
    in property <int> selected_index: 0;
    in property <[MousePresetOption]> options;
    in property <bool> enabled: true;
    in property <string> selector_label: "";

    callback selected(int);
    callback open_selector(length);

    height: 64px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: space-between;

        // Title and description block
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                font-family: Typography.font_family;
                font-size: Typography.size_body;
                font-weight: 600;
                color: root.enabled ? Palette.text_primary : Palette.text_tertiary;
            }

            Text {
                text: root.description;
                font-family: Typography.font_family;
                font-size: Typography.size_caption;
                color: Palette.text_secondary;
                wrap: word-wrap;
            }
        }

        // Selector / Control
        HorizontalLayout {
            alignment: end;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 210px;
                    height: 32px;
                    border-radius: 6px;
                    background: root.enabled ? (btn_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle) : Palette.bg_subtle;
                    border-width: 1px;
                    border-color: root.enabled ? (btn_touch.has_hover ? Palette.accent_primary : Palette.stroke_card) : Palette.stroke_card;

                    accessible-role: combobox;
                    accessible-label: root.selector_label;
                    accessible-value: root.action_label != "" ? root.action_label : ((root.selected_index >= 0 && root.selected_index < root.options.length) ? root.options[root.selected_index].label : "Select Action");
                    accessible-action-default => {
                        if root.enabled {
                            root.open_selector(64px);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;

                        Text {
                            text: root.action_label != "" ? root.action_label : ((root.selected_index >= 0 && root.selected_index < root.options.length) ? root.options[root.selected_index].label : "Select Action");
                            font-family: Typography.font_family;
                            font-size: Typography.size_caption;
                            font-weight: 500;
                            color: root.enabled ? Palette.text_primary : Palette.text_tertiary;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        // Small Chevron Indicator
                        Path {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - 8px) / 2;
                            stroke: root.enabled ? Palette.text_secondary : Palette.text_tertiary;
                            stroke-width: 1.2px;
                            MoveTo { x: 1; y: 2.5; } LineTo { x: 4; y: 5.5; } LineTo { x: 7; y: 2.5; }
                        }
                    }

                    btn_touch := TouchArea {
                        enabled: root.enabled;
                        clicked => {
                            root.open_selector(64px);
                        }
                    }
                }
            }
        }
    }
}

export component MousePane inherits VerticalLayout {
    in-out property <bool> mouse_enabled: true;
    in property <string> thumb_back_label: "Previous Virtual Desktop";
    in property <string> thumb_forward_label: "Next Virtual Desktop";
    in property <string> tilt_left_label: "Show Desktop";
    in property <string> tilt_right_label: "Task View";

    in property <int> thumb_back_index: 1; // prev_virtual_desktop
    in property <int> thumb_forward_index: 0; // next_virtual_desktop
    in property <int> tilt_left_index: 3; // show_desktop
    in property <int> tilt_right_index: 2; // task_view
    in property <[MousePresetOption]> preset_options;

    // Accessible labels
    in property <string> accessible_toggle: "Enable Mouse Navigation";
    in property <string> accessible_thumb_back: "Thumb Button 1 (Back) Action";
    in property <string> accessible_thumb_forward: "Thumb Button 2 (Forward) Action";
    in property <string> accessible_tilt_left: "Tilt Wheel Left Action";
    in property <string> accessible_tilt_right: "Tilt Wheel Right Action";
    in property <bool> show_defaults_button: false;

    callback toggle_mouse_navigation(bool);
    callback thumb_back_changed(int);
    callback thumb_forward_changed(int);
    callback tilt_left_changed(int);
    callback tilt_right_changed(int);
    callback open_selector(int, length);
    callback restore_defaults_clicked();

    spacing: 12px;
    alignment: start;

    // Heading Section
    HorizontalLayout {
        alignment: space-between;

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: "Mouse Navigation";
                font-family: Typography.font_family;
                font-size: Typography.size_heading;
                font-weight: 700;
                color: Palette.text_primary;
            }
            Text {
                text: "Driverless desktop multitasking with auxiliary mouse buttons and tilt wheel.";
                font-family: Typography.font_family;
                font-size: Typography.size_caption;
                color: Palette.text_secondary;
            }
        }

        if root.show_defaults_button : HorizontalLayout {
            alignment: end;
            padding-left: 12px;

            Rectangle {
                width: 96px;
                height: 32px;
                border-radius: 6px;
                background: restore_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;
                border-width: 1px;
                border-color: Palette.stroke_card;

                Text {
                    text: "↺ Defaults";
                    font-family: Typography.font_family;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Palette.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                restore_touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "Restore Mouse settings to defaults";
                    accessible-action-default => {
                        root.restore_defaults_clicked();
                    }
                    mouse-cursor: pointer;
                    clicked => {
                        root.restore_defaults_clicked();
                    }
                }
            }
        }
    }

    // Card 1: Master Enable / Disable
    Card {
        SettingToggleRow {
            title: "Enable Mouse Navigation";
            description: "Intercepts thumb buttons and horizontal tilt wheel for workspace and window commands.";
            toggle_accessible_label: root.accessible_toggle;
            checked <=> root.mouse_enabled;
            toggled(val) => { root.toggle_mouse_navigation(val); }
        }
    }

    // Card 2: Button & Wheel Mapping Presets
    Card {
        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            MouseActionRow {
                title: "Thumb Button 1 (Back)";
                description: "Standard lower/rear thumb button (XBUTTON1).";
                action_label: root.thumb_back_label;
                selected_index: root.thumb_back_index;
                options: root.preset_options;
                enabled: root.mouse_enabled;
                selector_label: root.accessible_thumb_back;
                selected(idx) => { root.thumb_back_changed(idx); }
                open_selector(y) => { root.open_selector(0, 180px); }
            }

            CardDivider {}

            MouseActionRow {
                title: "Thumb Button 2 (Forward)";
                description: "Standard upper/front thumb button (XBUTTON2).";
                action_label: root.thumb_forward_label;
                selected_index: root.thumb_forward_index;
                options: root.preset_options;
                enabled: root.mouse_enabled;
                selector_label: root.accessible_thumb_forward;
                selected(idx) => { root.thumb_forward_changed(idx); }
                open_selector(y) => { root.open_selector(1, 245px); }
            }

            CardDivider {}

            MouseActionRow {
                title: "Tilt Wheel Left";
                description: "Push scroll wheel horizontally to the left.";
                action_label: root.tilt_left_label;
                selected_index: root.tilt_left_index;
                options: root.preset_options;
                enabled: root.mouse_enabled;
                selector_label: root.accessible_tilt_left;
                selected(idx) => { root.tilt_left_changed(idx); }
                open_selector(y) => { root.open_selector(2, 310px); }
            }

            CardDivider {}

            MouseActionRow {
                title: "Tilt Wheel Right";
                description: "Push scroll wheel horizontally to the right.";
                action_label: root.tilt_right_label;
                selected_index: root.tilt_right_index;
                options: root.preset_options;
                enabled: root.mouse_enabled;
                selector_label: root.accessible_tilt_right;
                selected(idx) => { root.tilt_right_changed(idx); }
                open_selector(y) => { root.open_selector(3, 375px); }
            }
        }
    }
}
