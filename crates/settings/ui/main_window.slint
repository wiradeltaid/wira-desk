export { Palette, Typography } from "theme.slint";
import { Palette, Typography } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Titlebar } from "components/titlebar.slint";
import { Sidebar } from "components/sidebar.slint";
import { GeneralPane } from "panes/general_pane.slint";
import { ShortcutsPane, ShortcutRowData } from "panes/shortcuts_pane.slint";
import { MousePane, MousePresetOption } from "panes/mouse_pane.slint";
import { VmExceptionsPane } from "panes/vm_exceptions_pane.slint";
import { AboutPane } from "panes/about_pane.slint";
import { KeyCheck } from "components/key_check.slint";
import { ScrollHint } from "components/scroll_hint.slint";
import { OnboardingModal } from "onboarding.slint";

export struct DropdownItem {
    is_header: bool,
    label: string,
    slug: string,
    selectable: bool,
}

export component MainWindow inherits Window {
    title: "Wira Desk";
    no-frame: true;
    background: Colors.transparent;

    // Operational mode
    in property <bool> is_onboarding: false;
    in property <int> onboarding_step: 1;
    in property <int> onboarding_focus_index: 0;
    in property <bool> onboarding_sim_success: false;

    // Window size binding.
    //
    // The onboarding height is fixed rather than sized to content, so it has to fit the
    // tallest screen — the last one, since the start-at-sign-in question added a third row
    // to its card.
    //
    // Third value, and the first one taken from a screenshot rather than from arithmetic.
    // 440 was too tall; 412 still left roughly fifty pixels of slack on the last screen and
    // well over a hundred on the first. The reduction to 396 is smaller than that slack
    // because `InfoRow` simultaneously grew: it now has a 44px floor and vertical padding,
    // which is what fixes the stubby one-line row and the wrapped line pressed against the
    // card edge.
    //
    // The empty bands were never mostly about this number. They came from the middle region
    // centring the card inside its stretched space; see `onboarding.slint`.
    //
    // Deliberately not per-step. Only the last screen grew, but a window that resizes as the
    // user presses Next draws attention to itself at the moment the content should have it.
    out property <length> normal_width: 760px;
    out property <length> normal_height: 610px;
    width: is_onboarding ? 580px : root.normal_width;
    height: is_onboarding ? 396px : root.normal_height;

    // Navigation & Panes
    in-out property <int> current_pane: 0;

    // General Pane Properties
    in-out property <bool> auto_start: false;
    in-out property <bool> visual_switcher_enabled: true;
    in-out property <int> visual_hold_delay_ms: 300;
    callback visual_switcher_toggled(bool);
    callback visual_hold_delay_changed(int);

    // Shortcuts Pane Properties.
    //
    // Five models rather than one property per field per concern. The previous shape was
    // one `sc_`, one `conflict_`, and one `can_swap_` property per action; at nine actions
    // that is twenty-seven declarations here and twenty-seven more where they are bound,
    // and an action added to the model with any one of them forgotten is drawn wrong or not
    // at all. The Rust side builds these from `ShortcutField::ALL`, so the declared sequence
    // is the only list (`LBR-ST-14`).
    in property <[ShortcutRowData]> rows_switching;
    in property <[ShortcutRowData]> rows_snap_half;
    in property <[ShortcutRowData]> rows_snap_third;
    in property <[ShortcutRowData]> rows_snap_custom;
    in property <[ShortcutRowData]> rows_arrange;
    in property <int> listening_field: -1;

    // KeyCheck Properties
    in property <bool> kc_mod_ctrl: false;
    in property <bool> kc_mod_win: false;
    in property <bool> kc_mod_alt: false;
    in property <bool> kc_mod_shift: false;
    in property <string> kc_last_display: "";
    in property <string> kc_last_canonical: "";
    in property <int> kc_verdict: 0;
    in property <bool> kc_beat: false;

    // VM Exceptions Pane Properties
    in property <[string]> bypass_processes: [
        "mstsc.exe",
        "vmconnect.exe",
        "vmware.exe",
        "vmware-view.exe",
        "VirtualBoxVM.exe",
        "qemu-system-x86_64.exe",
        "wfica32.exe",
        "TeamViewer.exe",
        "AnyDesk.exe",
    ];
    in property <[string]> bypass_classes: [
        "VMwareUnityWindow",
        "TscShellContainerClass",
    ];

    // Mouse Pane Properties & Callbacks
    in-out property <bool> mouse_enabled: true;
    in property <string> thumb_back_label: "Previous Virtual Desktop";
    in property <string> thumb_forward_label: "Next Virtual Desktop";
    in property <string> tilt_left_label: "Show Desktop";
    in property <string> tilt_right_label: "Task View";
    in property <int> thumb_back_index: 1;
    in property <int> thumb_forward_index: 0;
    in property <int> tilt_left_index: 3;
    in property <int> tilt_right_index: 2;
    in property <[MousePresetOption]> mouse_preset_options: [];
    callback toggle_mouse_navigation(bool);
    callback thumb_back_changed(int);
    callback thumb_forward_changed(int);
    callback tilt_left_changed(int);
    callback tilt_right_changed(int);

    // Dropdown overlay properties
    in property <[DropdownItem]> dropdown_items: [];
    in-out property <bool> dropdown_open: false;
    in-out property <int> dropdown_slot: 0;
    in-out property <length> dropdown_y: 0px;
    callback preset_selected(int, string);

    // About Pane Properties
    in property <string> update_status: "";
    in property <bool> update_busy: false;
    in property <bool> update_ready: false;
    in property <string> update_version: "";
    in property <bool> update_has_notes: false;
    callback open_release_notes();
    in-out property <bool> check_updates: true;
    callback check_updates_clicked();
    callback install_update_clicked();
    callback check_updates_toggled(bool);
    callback open_publisher_url();
    callback open_source_url();
    callback open_support_url();
    in property <string> app_version: "0.1.0";
    in property <string> app_typeface: "Segoe UI Variable Text (System Loaded)";

    // Footer & Save State
    in property <bool> is_dirty: false;
    in property <bool> has_conflict: false;
    in property <int> revert_generation: 0;
    in property <string> status_message: "Wira Desk is Active";
    in property <bool> status_is_error: false;
    in property <bool> status_is_warning: false;
    in property <bool> status_is_success: false;

    // Floating Active Tooltip
    in-out property <string> active_tooltip_text: "";
    in-out property <length> active_tooltip_y: 0px;
    in-out property <bool> active_tooltip_visible: false;

    in-out property <bool> factory_reset_dialog_open: false;
    in property <bool> show_stack_conflict_banner: false;
    in property <bool> can_fix_stack_conflict: false;

    // Callbacks to Rust
    callback window_drag_requested();
    callback window_minimize_clicked();
    callback window_close_clicked();

    callback pane_selected(int);
    callback auto_start_toggled(bool);

    callback start_capture(int);
    callback swap_shortcuts(int);
    callback percent_changed(int, int);
    callback editing_percent_changed(int, int);
    callback shortcut_enabled_toggled(int, bool);
    callback restore_shortcuts_clicked();
    callback fix_stack_conflict_clicked();

    callback save_clicked();
    callback revert_clicked();

    callback open_issues_url();
    callback factory_reset_confirmed();

    callback onboarding_next();
    callback onboarding_back();
    callback onboarding_skip();
    callback onboarding_finish();
    in-out property <bool> onboarding_auto_start: true;
    callback onboarding_auto_start_toggled(bool);
    callback onboarding_simulate();

    callback key_pressed_event(string, bool, bool, bool, bool);
    callback key_released_event(string, bool, bool, bool, bool);
    callback key_check_beat_done();

    forward-focus: key_handler;

    key_handler := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if root.dropdown_open && event.text == Key.Escape {
                root.dropdown_open = false;
                return accept;
            }
            if root.factory_reset_dialog_open && event.text == Key.Escape {
                root.factory_reset_dialog_open = false;
                return accept;
            }
            if root.factory_reset_dialog_open {
                return accept;
            }
            root.key_pressed_event(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                event.modifiers.meta
            );
            if (event.text == Key.Tab || event.text == Key.Backtab) && root.listening_field == -1 {
                return reject;
            }
            accept
        }
        key-released(event) => {
            if root.factory_reset_dialog_open {
                return accept;
            }
            root.key_released_event(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                event.modifiers.meta
            );
            if (event.text == Key.Tab || event.text == Key.Backtab) && root.listening_field == -1 {
                return reject;
            }
            accept
        }

        // Outer Container
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Palette.bg_page;
            border-radius: is_onboarding ? 12px : 8px;
            clip: true;

        // No titlebar during onboarding, and that is a deliberate difference from
        // Settings rather than an omission. The tutorial already offers its own way out
        // -- Skip on the first screen, "Start Using Wira Desk" on the last -- so a close
        // button would be a third one, and a title bar frames a window the user has not
        // chosen to open yet.
        //
        // What the titlebar was also providing is dragging, because the window is
        // `no-frame` and had no other drag surface. The modal now carries one across its
        // top strip. Settings keeps the titlebar and keeps dragging from it; the drag
        // capability is not optional there, it just lives somewhere else here.
        if is_onboarding : VerticalLayout {
            padding: 0px;
            spacing: 0px;

            OnboardingModal {
                current_step: root.onboarding_step;
                focus_index: root.onboarding_focus_index;
                simulation_success: root.onboarding_sim_success;
                next_clicked => { root.onboarding_next(); }
                back_clicked => { root.onboarding_back(); }
                skip_clicked => { root.onboarding_skip(); }
                finish_clicked => { root.onboarding_finish(); }
                simulate_clicked => { root.onboarding_simulate(); }
                drag_requested => { root.window_drag_requested(); }
                auto_start <=> root.onboarding_auto_start;
                auto_start_toggled(val) => { root.onboarding_auto_start_toggled(val); }
            }
        }

        if !is_onboarding : VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // 1. Top Custom Titlebar
            Titlebar {
                title: "Wira Desk";
                is_onboarding: false;
                drag_requested => { root.window_drag_requested(); }
                minimize_clicked => { root.window_minimize_clicked(); }
                close_clicked => { root.window_close_clicked(); }
            }

            // 2. Middle Body: Left Sidebar + Right Mica Content Area
            HorizontalLayout {
                padding: 0px;
                spacing: 0px;

                Sidebar {
                    current_pane: root.current_pane;
                    dropdown_open: root.dropdown_open;
                    pane_selected(idx) => {
                        root.dropdown_open = false;
                        root.pane_selected(idx);
                    }
                    dismiss_dropdown => {
                        root.dropdown_open = false;
                    }
                }

                Rectangle {
                    background: Palette.bg_mica;
                    horizontal-stretch: 1;

                    VerticalLayout {

                    // Host for the scroll area plus its bottom affordance. A Rectangle rather
                    // than a layout because the hint has to *overlay* the last rows, not take
                    // a row of its own — a hint that pushes content up has not saved the
                    // reader anything.
                    Rectangle {
                        // Takes every pixel the pinned band below does not, so the band keeps
                        // its full height and the rows give up space instead of it.
                        vertical-stretch: 1;

                    sv := ScrollView {
                        width: 100%;
                        height: 100%;
                        viewport-x: 0px;

                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 16px;
                            padding-bottom: 16px;
                            alignment: start;
                            spacing: 12px;

                            if root.current_pane == 0 : GeneralPane {
                                auto_start <=> root.auto_start;
                                visual_switcher_enabled <=> root.visual_switcher_enabled;
                                visual_hold_delay_ms <=> root.visual_hold_delay_ms;
                                revert_generation: root.revert_generation;
                                auto_start_toggled(val) => { root.auto_start_toggled(val); }
                                visual_switcher_toggled(val) => { root.visual_switcher_toggled(val); }
                                visual_hold_delay_changed(val) => { root.visual_hold_delay_changed(val); }
                            }

                            if root.current_pane == 1 : ShortcutsPane {
                                rows_switching: root.rows_switching;
                                rows_snap_half: root.rows_snap_half;
                                rows_snap_third: root.rows_snap_third;
                                rows_snap_custom: root.rows_snap_custom;
                                rows_arrange: root.rows_arrange;
                                listening_field: root.listening_field;
                                revert_generation: root.revert_generation;

                                start_capture(idx) => { root.start_capture(idx); }
                                swap_shortcuts(idx) => { root.swap_shortcuts(idx); }
                                percent_changed(idx, val) => { root.percent_changed(idx, val); }
                                editing_percent_changed(idx, val) => { root.editing_percent_changed(idx, val); }
                                toggle_enabled(idx, val) => { root.shortcut_enabled_toggled(idx, val); }
                                show_stack_conflict_banner: root.show_stack_conflict_banner;
                                can_fix_stack_conflict: root.can_fix_stack_conflict;
                                restore_shortcuts_clicked => { root.restore_shortcuts_clicked(); }
                                fix_stack_conflict_clicked => { root.fix_stack_conflict_clicked(); }
                                show_tooltip(desc, pane_y) => {
                                    root.active_tooltip_text = desc;
                                    root.active_tooltip_y = 16px + sv.viewport-y + pane_y;
                                    root.active_tooltip_visible = true;
                                }
                                hide_tooltip => {
                                    root.active_tooltip_visible = false;
                                }
                            }

                            if root.current_pane == 2 : MousePane {
                                mouse_enabled <=> root.mouse_enabled;
                                thumb_back_label: root.thumb_back_label;
                                thumb_forward_label: root.thumb_forward_label;
                                tilt_left_label: root.tilt_left_label;
                                tilt_right_label: root.tilt_right_label;
                                thumb_back_index: root.thumb_back_index;
                                thumb_forward_index: root.thumb_forward_index;
                                tilt_left_index: root.tilt_left_index;
                                tilt_right_index: root.tilt_right_index;
                                preset_options: root.mouse_preset_options;

                                toggle_mouse_navigation(val) => { root.toggle_mouse_navigation(val); }
                                thumb_back_changed(idx) => { root.thumb_back_changed(idx); }
                                thumb_forward_changed(idx) => { root.thumb_forward_changed(idx); }
                                tilt_left_changed(idx) => { root.tilt_left_changed(idx); }
                                tilt_right_changed(idx) => { root.tilt_right_changed(idx); }
                                open_selector(slot, target_y) => {
                                    root.dropdown_slot = slot;
                                    root.dropdown_y = target_y;
                                    root.dropdown_open = true;
                                }
                            }

                            if root.current_pane == 3 : VmExceptionsPane {
                                bypass_processes: root.bypass_processes;
                                bypass_classes: root.bypass_classes;
                            }

                            if root.current_pane == 4 : AboutPane {
                                version: root.app_version;
                                typeface: root.app_typeface;
                                update_status: root.update_status;
                                update_busy: root.update_busy;
                                update_ready: root.update_ready;
                                update_version: root.update_version;
                                update_has_notes: root.update_has_notes;
                                open_release_notes => { root.open_release_notes(); }
                                check_updates <=> root.check_updates;
                                check_updates_clicked => { root.check_updates_clicked(); }
                                install_update_clicked => { root.install_update_clicked(); }
                                check_updates_toggled(val) => { root.check_updates_toggled(val); }
                                open_publisher_url => { root.open_publisher_url(); }
                                open_source_url => { root.open_source_url(); }
                                open_support_url => { root.open_support_url(); }
                                open_issues_url => { root.open_issues_url(); }
                                reset_all_settings_clicked => { root.factory_reset_dialog_open = true; }
                            }
                        }
                    }

                    // Shown only while there is genuinely more below and the reader has not
                    // scrolled yet. Not restricted to one pane: the condition already
                    // silences it wherever the content fits, so special-casing a pane would
                    // be a second rule saying the same thing.
                    ScrollHint {
                        x: 0;
                        width: parent.width;
                        y: parent.height - self.height;
                        active: sv.viewport-height > sv.visible-height + 4px
                            && sv.viewport-y > -12px;
                    }
                    }

                    // Pinned Key check band, Shortcuts pane only.
                    //
                    // Outside the ScrollView on purpose. The nine shortcut rows are taller
                    // than the window, so while it sat at the end of the pane it was below
                    // the fold exactly when a user was pressing chords to test them — a live
                    // instrument nobody could see. Pinning it inverts that: the rows scroll,
                    // the readout does not.
                    //
                    // Only on this pane, because the daemon arms its observe lease from which
                    // pane is showing, so a reading is only meaningful here.
                    if root.current_pane == 1 : Rectangle {
                        height: 1px;
                        background: Palette.stroke_card;
                    }

                    if root.current_pane == 1 : Rectangle {
                        background: Palette.bg_mica;
                        vertical-stretch: 0;

                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 10px;
                            padding-bottom: 10px;

                            KeyCheck {
                                mod_ctrl: root.kc_mod_ctrl;
                                mod_win: root.kc_mod_win;
                                mod_alt: root.kc_mod_alt;
                                mod_shift: root.kc_mod_shift;
                                last_display: root.kc_last_display;
                                last_canonical: root.kc_last_canonical;
                                verdict: root.kc_verdict;
                                beat: root.kc_beat;
                                beat_done => {
                                    root.key_check_beat_done();
                                }
                            }
                        }
                    }

                    }

                    // Floating Tooltip Overlay (drawn above ScrollView, above rows, and above KeyCheck)
                    if root.active_tooltip_visible && root.active_tooltip_text != "" : Rectangle {
                        x: 36px;
                        y: root.active_tooltip_y;
                        z: 1000;
                        background: Palette.bg_tooltip;
                        border-width: 1px;
                        border-color: Palette.stroke_tooltip;
                        border-radius: 4px;
                        width: min(480px, tooltip_layout.preferred-width);
                        height: tooltip_layout.preferred-height;

                        tooltip_layout := HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;

                            Text {
                                text: root.active_tooltip_text;
                                font-family: Typography.font_family;
                                font-size: Typography.size_caption;
                                color: Palette.text_primary;
                                wrap: word-wrap;
                                accessible-role: text;
                                accessible-label: root.active_tooltip_text;
                            }
                        }
                    }

                    // Floating Preset Dropdown Overlay (SPEC-9-05)
                    if root.dropdown_open : Rectangle {
                        z: 999;
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        background: transparent;

                        TouchArea {
                            clicked => {
                                root.dropdown_open = false;
                            }
                        }
                    }

                    if root.dropdown_open : Rectangle {
                        z: 1000;
                        x: parent.width - self.width - 32px;
                        y: min(root.dropdown_y, parent.height - 275px);
                        width: 250px;
                        height: min(260px, dropdown_list.preferred-height + 16px);
                        background: Palette.bg_card;
                        border-width: 1px;
                        border-color: Palette.stroke_card;
                        border-radius: 8px;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: Palette.is_dark ? rgba(0, 0, 0, 0.45) : rgba(0, 0, 0, 0.15);
                        drop-shadow-offset-y: 6px;

                        ScrollView {
                            dropdown_list := VerticalLayout {
                                spacing: 2px;
                                padding: 4px;
                                for item[idx] in root.dropdown_items: Rectangle {
                                    height: item.is_header ? 24px : 28px;
                                    border-radius: 4px;

                                    if item.is_header : Rectangle {
                                        background: transparent;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 8px;
                                            alignment: start;

                                            Text {
                                                text: item.label;
                                                font-family: Typography.font_family;
                                                font-size: 10.5px;
                                                font-weight: 700;
                                                color: Palette.text_tertiary;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: default;
                                            clicked => {
                                                // Absorb click so category headers are inert and don't dismiss overlay
                                            }
                                        }
                                    }

                                    if !item.is_header : Rectangle {
                                        background: item_touch.has_hover ? Palette.bg_card_hover : transparent;
                                        border-radius: 4px;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 8px;
                                            alignment: start;

                                            Text {
                                                text: item.label;
                                                font-family: Typography.font_family;
                                                font-size: 12px;
                                                font-weight: 500;
                                                color: Palette.text_primary;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        item_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            accessible-role: button;
                                            accessible-label: item.label;
                                            clicked => {
                                                root.dropdown_open = false;
                                                root.preset_selected(root.dropdown_slot, item.slug);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 3. Sticky Bottom Save / Revert Footer Bar
            Rectangle {
                height: 56px;
                background: Palette.bg_card;
                border-width: 1px;
                border-color: Palette.stroke_card;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    // Status Indicator Dot + Message (Constrained to prevent pushing buttons)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        horizontal-stretch: 1;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - 8px) / 2;
                            border-radius: 4px;
                            background: root.status_is_error ? Palette.signal_error :
                                       (root.status_is_warning ? Palette.signal_warning : Palette.signal_success);
                        }

                        Text {
                            text: root.status_message;
                            font-family: Typography.font_family;
                            font-size: 12px;
                            font-weight: 600;
                            color: root.status_is_error ? Palette.signal_error :
                                  (root.status_is_warning ? Palette.signal_warning :
                                  (root.status_is_success ? Palette.signal_success : Palette.text_primary));
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    // Action Buttons (Revert & Save)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        Rectangle {
                            width: 80px;
                            height: 32px;
                            y: (parent.height - 32px) / 2;
                            border-radius: 6px;
                            background: root.is_dirty ? (revert_touch.has_hover ? Palette.bg_card_hover : Palette.bg_keycap) : Palette.bg_subtle;
                            border-width: 1px;
                            border-color: Palette.stroke_card;

                            Text {
                                text: "Revert";
                                font-family: Typography.font_family;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: root.is_dirty ? Palette.text_primary : Palette.text_tertiary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            revert_touch := TouchArea {
                                enabled: root.is_dirty && !root.factory_reset_dialog_open;
                                accessible-role: button;
                                accessible-label: "Revert";
                                accessible-action-default => {
                                    if root.is_dirty && !root.factory_reset_dialog_open {
                                        root.revert_clicked();
                                    }
                                }
                                clicked => {
                                    root.revert_clicked();
                                }
                            }
                        }

                        Rectangle {
                            width: 120px;
                            height: 32px;
                            y: (parent.height - 32px) / 2;
                            border-radius: 6px;
                            background: (root.is_dirty && !root.factory_reset_dialog_open) ? (save_touch.has_hover ? Palette.accent_hover : Palette.accent_primary) : Palette.bg_subtle;
                            border-width: root.is_dirty ? 0px : 1px;
                            border-color: Palette.stroke_card;

                            accessible-role: button;
                            accessible-label: "Save Changes";
                            accessible-action-default => {
                                if root.is_dirty && !root.factory_reset_dialog_open {
                                    root.save_clicked();
                                }
                            }

                            Text {
                                text: "Save Changes";
                                font-family: Typography.font_family;
                                font-size: 13px;
                                font-weight: 700;
                                color: (root.is_dirty && !root.factory_reset_dialog_open) ? Palette.text_on_accent : Palette.text_tertiary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            save_touch := TouchArea {
                                enabled: root.is_dirty && !root.factory_reset_dialog_open;
                                clicked => {
                                    root.save_clicked();
                                }
                            }
                        }
                    }
                }
            }
        }

        // Window-Level Modal Overlay: Factory Reset Confirmation (SPEC-25-02)
        if root.factory_reset_dialog_open : modal_focus := FocusScope {
            z: 2000;
            width: 100%;
            height: 100%;

            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.factory_reset_dialog_open = false;
                    return accept;
                }
                accept
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: Palette.is_dark ? rgba(0, 0, 0, 0.65) : rgba(0, 0, 0, 0.4);

                TouchArea {
                    // Absorbs clicks on the backdrop to block interaction with background controls
                    clicked => {}
                }
            }

            Rectangle {
                width: 440px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.bg_card;
                border-width: 1px;
                border-color: Palette.stroke_card;
                border-radius: 8px;
                drop-shadow-blur: 24px;
                drop-shadow-color: Palette.is_dark ? rgba(0, 0, 0, 0.6) : rgba(0, 0, 0, 0.2);
                drop-shadow-offset-y: 8px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    Text {
                        text: "Restore all preferences to defaults?";
                        font-family: Typography.font_family;
                        font-size: Typography.size_heading;
                        font-weight: 700;
                        color: Palette.text_primary;
                        accessible-role: text;
                        accessible-label: "Restore all preferences to defaults?";
                    }

                    Text {
                        text: "This will reset General, visual switcher, Shortcuts, Mouse, and VM exceptions preferences in your current draft to factory defaults.\n\nNo saved settings, config file on disk, or scheduled tasks will change until you choose Save Changes.";
                        font-family: Typography.font_family;
                        font-size: Typography.size_body;
                        color: Palette.text_secondary;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: "This will reset General, visual switcher, Shortcuts, Mouse, and VM exceptions preferences in your current draft to factory defaults. No saved settings, config file on disk, or scheduled tasks will change until you choose Save Changes.";
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        padding-top: 6px;

                        Rectangle {
                            width: 80px;
                            height: 32px;
                            border-radius: 6px;
                            background: cancel_reset_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;
                            border-width: 1px;
                            border-color: Palette.stroke_card;

                            Text {
                                text: "Cancel";
                                accessible-role: none;
                                font-family: Typography.font_family;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Palette.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            cancel_reset_touch := TouchArea {
                                accessible-role: button;
                                accessible-label: "Cancel";
                                accessible-action-default => {
                                    root.factory_reset_dialog_open = false;
                                }
                                mouse-cursor: pointer;
                                clicked => {
                                    root.factory_reset_dialog_open = false;
                                }
                            }
                        }

                        Rectangle {
                            width: 170px;
                            height: 32px;
                            border-radius: 6px;
                            background: confirm_reset_touch.has_hover ? Palette.signal_error : Palette.signal_error;

                            Text {
                                text: "Restore all preferences";
                                accessible-role: none;
                                font-family: Typography.font_family;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Palette.text_on_accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            confirm_reset_touch := TouchArea {
                                accessible-role: button;
                                accessible-label: "Confirm reset all preferences to defaults";
                                accessible-action-default => {
                                    root.factory_reset_dialog_open = false;
                                    root.factory_reset_confirmed();
                                }
                                mouse-cursor: pointer;
                                clicked => {
                                    root.factory_reset_dialog_open = false;
                                    root.factory_reset_confirmed();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
}
